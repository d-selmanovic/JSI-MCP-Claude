# Nur Namen – echte Werte NIE committen. In der Cloud-Umgebung bzw. beim Hoster als Secret setzen.

# Mirror-/Testdatenbank (Backup-/Testserver „MiroServ“, Aiven MySQL)
JSI_MIRROR_DB_HOST=
JSI_MIRROR_DB_PORT=
JSI_MIRROR_DB_NAME=
JSI_MIRROR_DB_USER=
JSI_MIRROR_DB_PASSWORD=

# Produktion (später, eigener Benutzer mit minimalen Rechten)
JSI_DB_HOST=
JSI_DB_PORT=
JSI_DB_NAME=
JSI_DB_USER=
JSI_DB_PASSWORD=

# Welche DB der Server nutzt: mirror | prod
JSI_DB_TARGET=mirror

# Authentifizierung über WorkOS AuthKit (OAuth 2.1 für MCP)
WORKOS_AUTHKIT_DOMAIN=
WORKOS_CLIENT_ID=
# Öffentliche URL des MCP-Servers = Resource Indicator / Token-Audience
JSI_MCP_PUBLIC_URL=

# --- JSI-MCP-Server (server/) – weitere Variablen, siehe server/README.md
PORT=3000
# Aiven-CA als PEM-Inhalt (öffentlich, kein Secret) oder Datei server/certs/aiven-ca.pem
JSI_DB_CA_CERT=
JSI_DB_SSL_REQUIRED=true
# Schreiben nur wenn true UND JSI_DB_TARGET=mirror
JSI_WRITES_ENABLED=false
# idk_employees.employee_id als Autor von Notizen/Pipeline-Log (0 = keiner)
JSI_WRITE_EMPLOYEE_ID=0
# lsp_izvor für Pipeline-Log (1 = CRM)
JSI_LSP_IZVOR=1
# NUR lokal: JSI_AUTH_DISABLED=true + JSI_MCP_PUBLIC_URL=http://localhost:3000/mcp
JSI_AUTH_DISABLED=false
